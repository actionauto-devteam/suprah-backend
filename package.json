{
  "name": "ts-node-express",
  "version": "1.0.0",
  "description": "TypeScript + Node.js + Express starter",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:ftp": "dotenv -e .env -- nodemon --exec ts-node src/ftp-worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:ftp": "node dist/ftp-worker.js",
    "seed": "ts-node scripts/seed.ts",
    "seed:dev": "ts-node-dev --transpile-only scripts/seed.ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "node",
    "typescript",
    "express"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "basic-ftp": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bunyan": "^1.8.15",
    "chokidar": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "deep-diff": "^1.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "ftp-srv": "^4.6.3",
    "googleapis": "^171.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^8.4.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bunyan": "^1.8.11",
    "@types/chokidar": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/deep-diff": "^1.0.5",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.29",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
