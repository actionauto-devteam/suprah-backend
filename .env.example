# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/action-auto-backend

# JWT Secrets
# Use strong, randomly generated strings for these in production
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret

# Token Expiration
# Examples: 60s, 15m, 1h, 7d
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=10

# DealersCloud FTP Configuration
DEALERSCLOUD_FTP_HOST=ftp.dealerscloud.com
DEALERSCLOUD_FTP_USER=your_username
DEALERSCLOUD_FTP_PASSWORD=your_password
DEALERSCLOUD_FTP_FILE=DealerCloud.txt

# Sync Configuration (Cron expression, e.g., '0 0 * * *' for midnight)
SYNC_SCHEDULE="0 0 * * *"

# FTP Server Configuration (for receiving files from DealersCloud)
FTP_SERVER_PORT=2121
FTP_PASSIVE_URL=127.0.0.1
FTP_PASV_MIN=21000
FTP_PASV_MAX=21010
FTP_SERVER_USER=dealerscloud
FTP_SERVER_PASSWORD=your_secure_password_here
FTP_UPLOAD_DIR=./ftp-uploads
